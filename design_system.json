{
  "name": "ASRI COLLECTION Design System",
  "file": "design_system.json",
  "version": "1.1.0",
  "status": "draft",
  "product": "ASRI COLLECTION",
  "type": "ecommerce_storefront",
  "platform": [
    "web",
    "mobile",
    "tablet",
    "desktop"
  ],
  "framework": [
    "React",
    "TypeScript",
    "Vite"
  ],
  "principles": [
    "mobile_first",
    "responsive",
    "minimal_modern",
    "reusable_components",
    "accessible",
    "performance_aware",
    "guest_checkout",
    "backend_driven_state"
  ],
  "scope": "Customer-facing storefront only. No admin dashboard, login page, or registration page.",
  "source_requirements": "ASRI COLLECTION — PAGE REQUIREMENTS V1.0",
  "brand": {
    "name": "ASRI COLLECTION",
    "personality": [
      "modern",
      "minimal",
      "elegant",
      "approachable",
      "reliable"
    ],
    "visual_direction": "Modern minimalist ecommerce storefront with generous whitespace, clear product photography, restrained emerald accents, dark typography, and high-contrast purchase actions.",
    "logo": {
      "placement": "header",
      "preferred_variant": "wordmark",
      "clear_space": "at_least_logo_mark_height",
      "minimum_size": "preserve_legibility",
      "fallback": "text_wordmark"
    }
  },
  "design_tokens": {
    "color": {
      "primitive": {
        "brand": {
          "emerald_800": "#116B32",
          "emerald_700": "#0D5728",
          "emerald_600": "#16803D",
          "emerald_500": "#1B9148",
          "emerald_50": "#EAF5EE"
        },
        "orange": {
          "50": "#FFF0E9",
          "500": "#F15A24"
        },
        "neutral": {
          "white": "#FFFFFF",
          "black": "#111111",
          "gray_950": "#171717",
          "gray_900": "#262626",
          "gray_800": "#404040",
          "gray_700": "#525252",
          "gray_600": "#737373",
          "gray_500": "#8A8A8A",
          "gray_400": "#A3A3A3",
          "gray_300": "#D4D4D4",
          "gray_200": "#E5E5E5",
          "gray_100": "#F5F5F5",
          "gray_50": "#FAFAFA"
        }
      },
      "semantic": {
        "text": {
          "primary": "#171717",
          "secondary": "#525252",
          "muted": "#737373",
          "inverse": "#FFFFFF",
          "disabled": "#737373",
          "link": "#16803D"
        },
        "surface": {
          "page": "#FFFFFF",
          "default": "#FFFFFF",
          "subtle": "#FAFAFA",
          "muted": "#F5F5F5",
          "raised": "#FFFFFF",
          "overlay": "rgba(17, 17, 17, 0.48)",
          "disabled": "#F5F5F5"
        },
        "border": {
          "default": "1px solid #E5E5E5",
          "strong": "1px solid #D4D4D4",
          "focus": "2px solid #16803D",
          "error": "1px solid #D92D20",
          "disabled": "1px solid #E5E5E5"
        },
        "action": {
          "primary": "#16803D",
          "primary_hover": "#116B32",
          "primary_pressed": "#0D5728",
          "secondary": "#FFFFFF",
          "danger": "#D92D20"
        },
        "status": {
          "success": {
            "foreground": "#16803D",
            "background": "#EAF5EE"
          },
          "warning": {
            "foreground": "#754500",
            "background": "#FFF7E6"
          },
          "error": {
            "foreground": "#B42318",
            "background": "#FEF0EF"
          },
          "info": {
            "foreground": "#1D4ED8",
            "background": "#EFF6FF"
          }
        }
      },
      "rules": [
        "Components must reference semantic tokens instead of hardcoded color values.",
        "Primitive tokens are used only to define semantic tokens.",
        "Do not communicate status through color alone.",
        "Maintain WCAG 2.2 AA contrast for applicable text and interactive controls.",
        "V1 supports light mode only; dark mode is deferred."
      ]
    },
    "typography": {
      "font_family": {
        "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
      },
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "scale": {
        "display": {
          "font_size": "32px",
          "line_height": 1.2,
          "weight": 700
        },
        "h1": {
          "font_size": "28px",
          "line_height": 1.25,
          "weight": 700
        },
        "h2": {
          "font_size": "24px",
          "line_height": 1.3,
          "weight": 600
        },
        "h3": {
          "font_size": "20px",
          "line_height": 1.35,
          "weight": 600
        },
        "h4": {
          "font_size": "18px",
          "line_height": 1.4,
          "weight": 600
        },
        "body_lg": {
          "font_size": "16px",
          "line_height": 1.5,
          "weight": 400
        },
        "body": {
          "font_size": "14px",
          "line_height": 1.5,
          "weight": 400
        },
        "body_sm": {
          "font_size": "13px",
          "line_height": 1.45,
          "weight": 400
        },
        "label": {
          "font_size": "14px",
          "line_height": 1.4,
          "weight": 500
        },
        "price": {
          "font_size": "16px",
          "line_height": 1.4,
          "weight": 700,
          "font_variant_numeric": "tabular-nums"
        },
        "caption": {
          "font_size": "12px",
          "line_height": 1.4,
          "weight": 400
        },
        "overline": {
          "font_size": "11px",
          "line_height": 1.35,
          "weight": 600,
          "letter_spacing": "0.06em"
        }
      },
      "rules": [
        "Use sentence case for labels and headings.",
        "Use tabular numerals for prices, quantities, and order identifiers where supported.",
        "Clamp product names consistently.",
        "Avoid using more than three text sizes within a compact component."
      ]
    },
    "spacing": {
      "base_unit": 4,
      "scale": {
        "0": "0px",
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "8": "32px",
        "10": "40px",
        "12": "48px",
        "16": "64px",
        "20": "80px"
      },
      "page_gutter": {
        "mobile": "16px",
        "tablet": "24px",
        "desktop": "32px"
      },
      "section_gap": {
        "mobile": "24px",
        "tablet": "32px",
        "desktop": "40px"
      },
      "component_gap": "8px",
      "form_field_gap": "16px",
      "inline_gap": "8px"
    },
    "sizing": {
      "control_height": {
        "sm": "36px",
        "md": "44px",
        "lg": "52px"
      },
      "interactive_target_minimum": "44px",
      "icon_size": {
        "xs": "14px",
        "sm": "16px",
        "md": "20px",
        "lg": "24px",
        "xl": "32px"
      },
      "content_max_width": "1200px",
      "product_image_aspect_ratio": "1:1",
      "hero_aspect_ratio": "16:9"
    },
    "radius": {
      "none": "0px",
      "xs": "4px",
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "xl": "20px",
      "2xl": "24px",
      "pill": "9999px"
    },
    "border": {
      "width": "1px",
      "style": "solid",
      "focus_offset": "2px"
    },
    "shadow": {
      "none": "none",
      "sm": "0 1px 2px rgba(0,0,0,0.05)",
      "md": "0 4px 12px rgba(0,0,0,0.08)",
      "lg": "0 12px 32px rgba(0,0,0,0.12)",
      "overlay": "0 16px 48px rgba(0,0,0,0.18)"
    },
    "motion": {
      "duration_fast": "120ms",
      "duration_normal": "200ms",
      "duration_slow": "300ms",
      "easing_standard": "cubic-bezier(0.2, 0, 0, 1)",
      "reduced_motion": "disable_nonessential_motion",
      "rules": [
        "Prefer subtle transitions.",
        "Respect prefers-reduced-motion.",
        "Do not delay checkout or purchase actions with animation."
      ]
    },
    "z_index": {
      "base": 0,
      "sticky": 10,
      "header": 20,
      "popover": 30,
      "drawer_backdrop": 40,
      "drawer": 50,
      "modal_backdrop": 60,
      "modal": 70,
      "toast": 80,
      "tooltip": 90
    }
  },
  "responsive": {
    "strategy": "mobile_first",
    "breakpoints": {
      "xs": "0px",
      "sm": "480px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "layouts": {
      "mobile": {
        "page_gutter": "16px",
        "product_grid_columns": 2,
        "content_width": "100%",
        "navigation": "compact_header_and_contextual_navigation",
        "sticky_purchase_bar": true
      },
      "tablet": {
        "page_gutter": "24px",
        "product_grid_columns": 3,
        "content_width": "100%",
        "navigation": "expanded_header"
      },
      "desktop": {
        "page_gutter": "32px",
        "product_grid_columns": 4,
        "content_width": "min(100% - 64px, 1200px)",
        "navigation": "expanded_header"
      }
    },
    "rules": [
      "Design and validate mobile layouts first.",
      "Prevent horizontal overflow at every breakpoint.",
      "Use responsive grids for product listings.",
      "Keep checkout actions visible and reachable on small screens.",
      "On desktop, center the storefront within the maximum content width."
    ]
  },
  "layout": {
    "app_shell": {
      "header": {
        "height": {
          "mobile": "56px",
          "desktop": "68px"
        },
        "position": "sticky",
        "background": "#FFFFFF",
        "border_bottom": "1px solid #E5E5E5",
        "elements": [
          "AppLogo",
          "CartBtn",
          "ProfileBtn"
        ],
        "rules": [
          "Keep the logo visually dominant but compact.",
          "CartBtn displays a count badge when cart quantity is greater than zero.",
          "Header actions use accessible labels and minimum 44px touch targets."
        ]
      },
      "main": {
        "container": "responsive",
        "max_width": "1200px",
        "page_transition": "subtle_or_none",
        "route_management": "React Router"
      },
      "footer": {
        "background": "#FAFAFA",
        "sections": [
          "store_information",
          "help_links",
          "policies",
          "social_links"
        ]
      }
    },
    "page_templates": {
      "storefront": {
        "header": "AppShell.Header",
        "main": "AppShell.Main",
        "content_width": "responsive",
        "bottom_navigation": "not_assumed_by_this_baseline"
      },
      "standalone": {
        "header": "contextual_page_header",
        "main": "standalone_content",
        "show_back_button": true,
        "content_width": "responsive"
      },
      "supporting": {
        "header": "contextual_page_header",
        "main": "support_content"
      },
      "system": {
        "layout": "focused_centered_state",
        "main": "system_feedback_content"
      }
    }
  },
  "components": {
    "buttons": {
      "variants": {
        "primary": {
          "background": "design_tokens.color.semantic.action.primary",
          "text": "design_tokens.color.semantic.text.inverse",
          "border": "transparent"
        },
        "secondary": {
          "background": "design_tokens.color.semantic.action.secondary",
          "text": "design_tokens.color.semantic.text.primary",
          "border": "design_tokens.color.semantic.border.strong"
        },
        "tertiary": {
          "background": "transparent",
          "text": "design_tokens.color.semantic.text.link",
          "border": "transparent"
        },
        "danger": {
          "background": "design_tokens.color.semantic.action.danger",
          "text": "design_tokens.color.semantic.text.inverse",
          "border": "transparent"
        }
      },
      "sizes": {
        "sm": "36px",
        "md": "44px",
        "lg": "52px"
      },
      "states": [
        "default",
        "hover",
        "pressed",
        "focus_visible",
        "disabled",
        "loading"
      ],
      "rules": [
        "Use one dominant primary action per visual region.",
        "Use semantic color tokens for all variants.",
        "Show loading feedback during asynchronous actions.",
        "Prevent duplicate submission while loading.",
        "Small controls must retain an interactive hit area of at least 44px where practical."
      ]
    },
    "form_fields": {
      "height": "44px",
      "radius": "design_tokens.radius.md",
      "background": "design_tokens.color.semantic.surface.default",
      "border": "design_tokens.color.semantic.border.default",
      "types": [
        "text",
        "email",
        "tel",
        "number",
        "textarea",
        "select",
        "checkbox",
        "radio"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "filled",
        "invalid",
        "disabled",
        "loading"
      ],
      "elements": [
        "label",
        "control",
        "helper_text",
        "error_message"
      ],
      "rules": [
        "Every field must have an accessible persistent label.",
        "Use suitable input types and autocomplete attributes.",
        "Show field-level validation close to the relevant input.",
        "Preserve user input after recoverable errors.",
        "Use semantic color tokens for validation feedback."
      ]
    },
    "product_card": {
      "layout": "vertical",
      "image_ratio": "1:1",
      "image_fit": "cover",
      "background": "design_tokens.color.semantic.surface.default",
      "border": "design_tokens.color.semantic.border.default",
      "radius": "design_tokens.radius.lg",
      "padding": "design_tokens.spacing.scale.2",
      "elements": [
        "ProductImage",
        "ProductBadge_optional",
        "WishlistButton",
        "ProductName",
        "ProductPrice",
        "AvailabilityLabel",
        "AddToCartButton_optional"
      ],
      "rules": [
        "Use consistent product image ratios.",
        "Clamp product name to two lines in compact cards.",
        "Do not display fabricated ratings, stock, discounts, or badges.",
        "Display availability separately from stock quantity.",
        "Use backend product data as the source of truth.",
        "Show an image fallback when product imagery is unavailable."
      ]
    },
    "wishlist_button": {
      "variants": [
        "icon_only"
      ],
      "states": [
        "inactive",
        "active",
        "hover",
        "focus_visible",
        "disabled",
        "loading"
      ],
      "accessibility": {
        "inactive_label": "Add to wishlist",
        "active_label": "Remove from wishlist",
        "must_have_accessible_name": true
      },
      "rules": [
        "Use a consistent heart icon.",
        "Show a clear active state.",
        "Prevent duplicate wishlist actions while loading.",
        "Provide feedback after a successful action."
      ]
    },
    "product_grid": {
      "columns": {
        "mobile": 2,
        "tablet": 3,
        "desktop": 4
      },
      "gap": "design_tokens.spacing.scale.3",
      "alignment": "stretch",
      "states": [
        "loading",
        "loaded",
        "empty",
        "error"
      ]
    },
    "product_gallery": {
      "main_image_ratio": "1:1",
      "thumbnail_size": "64px",
      "image_fit": "contain",
      "features": [
        "thumbnail_selection",
        "image_counter",
        "swipe_on_mobile"
      ],
      "states": [
        "loading",
        "loaded",
        "image_error"
      ],
      "rules": [
        "Provide image fallback.",
        "Keep thumbnail interaction accessible.",
        "Use a minimum 44px interactive target.",
        "Zoom and fullscreen are not required for V1."
      ]
    },
    "price": {
      "current_price": {
        "color": "design_tokens.color.semantic.text.primary",
        "weight": 700
      },
      "original_price": {
        "color": "design_tokens.color.semantic.text.secondary",
        "decoration": "line-through",
        "optional": true
      },
      "discount_badge": {
        "background": "design_tokens.color.semantic.status.warning.background",
        "text": "design_tokens.color.semantic.status.warning.foreground",
        "optional": true
      },
      "currency": "IDR",
      "format": "Rp with Indonesian thousands separators",
      "decimal_places": 0,
      "rules": [
        "Use backend product price as the source of truth.",
        "Display discounts only when valid discount data exists.",
        "Product variants use the same product price in V1.",
        "Presentation components must not calculate authoritative order totals."
      ]
    },
    "badges": {
      "availability": {
        "available": {
          "background": "design_tokens.color.semantic.status.success.background",
          "text": "design_tokens.color.semantic.status.success.foreground"
        },
        "unavailable": {
          "background": "design_tokens.color.semantic.status.error.background",
          "text": "design_tokens.color.semantic.status.error.foreground"
        }
      },
      "status_domains": [
        "order_status",
        "payment_status",
        "shipping_status",
        "refund_status"
      ],
      "rules": [
        "Map labels and visual styles from approved backend status values.",
        "Do not invent status values in the design system.",
        "Every status badge must include readable text.",
        "Do not use color as the only status indicator."
      ]
    },
    "quantity_stepper": {
      "height": "44px",
      "minimum": 1,
      "controls": [
        "decrement",
        "value",
        "increment"
      ],
      "states": [
        "default",
        "disabled",
        "loading",
        "limit_reached"
      ],
      "rules": [
        "Disable decrement at minimum quantity.",
        "Disable increment at the displayed available stock limit.",
        "Validate quantity again on the server.",
        "Client-side stock is not authoritative."
      ]
    },
    "search_input": {
      "height": "44px",
      "radius": "design_tokens.radius.pill",
      "elements": [
        "search_icon",
        "input",
        "clear_button_optional"
      ],
      "states": [
        "idle",
        "typing",
        "loading",
        "suggestions",
        "results",
        "empty",
        "error"
      ]
    },
    "filter_sort": {
      "presentation_mobile": "bottom_drawer",
      "presentation_desktop": "side_panel",
      "actions": [
        "apply",
        "reset",
        "close"
      ]
    },
    "cards": {
      "default": {
        "background": "design_tokens.color.semantic.surface.default",
        "border": "design_tokens.color.semantic.border.default",
        "radius": "design_tokens.radius.lg",
        "padding": "design_tokens.spacing.scale.4"
      },
      "interactive": {
        "hover_shadow": "design_tokens.shadow.md",
        "focus_visible": "design_tokens.color.semantic.border.focus"
      }
    },
    "status_badge": {
      "shape": "pill",
      "padding": "4px 8px",
      "font_size": "12px",
      "must_include_text": true
    },
    "timeline": {
      "orientation": "vertical",
      "elements": [
        "status_icon",
        "title",
        "description_optional",
        "timestamp"
      ],
      "states": [
        "completed",
        "current",
        "upcoming",
        "attention_required"
      ],
      "rules": [
        "Use backend order lifecycle as the source of timeline events.",
        "Emphasize the current state.",
        "Do not infer payment success from frontend navigation."
      ]
    },
    "feedback": {
      "empty_state": {
        "alignment": "center",
        "elements": [
          "illustration_optional",
          "title",
          "description",
          "action_optional"
        ]
      },
      "loading_state": {
        "patterns": [
          "skeleton",
          "inline_spinner",
          "button_spinner"
        ],
        "rules": [
          "Use skeletons for content-shaped loading.",
          "Avoid blocking the entire page for local updates."
        ]
      },
      "error_state": {
        "elements": [
          "icon",
          "title",
          "description",
          "retry_action_optional"
        ],
        "rules": [
          "Use actionable non-technical messages.",
          "Do not expose secrets or internal stack traces.",
          "Preserve user input after recoverable errors."
        ]
      }
    },
    "modal": {
      "desktop_width": "min(480px, calc(100vw - 32px))",
      "mobile_presentation": "near_full_width_dialog",
      "radius": "design_tokens.radius.xl",
      "close_on_escape": true,
      "close_on_backdrop": "only_when_safe",
      "accessibility": [
        "focus_trap",
        "restore_focus_on_close",
        "accessible_title",
        "keyboard_navigation"
      ]
    },
    "bottom_drawer": {
      "mobile_presentation": "bottom_sheet",
      "top_radius": "design_tokens.radius.xl",
      "max_height": "85vh",
      "supports_drag_handle": true,
      "must_keep_primary_action_visible": true,
      "rules": [
        "Respect device safe areas.",
        "Handle virtual keyboard visibility.",
        "Prevent background scrolling when open.",
        "Keep close action accessible."
      ]
    },
    "quick_view": {
      "mobile_presentation": "bottom_drawer",
      "desktop_presentation": "modal",
      "content": [
        "product_image",
        "product_name",
        "price",
        "variant_selector",
        "quantity_stepper",
        "wishlist_action",
        "add_to_cart_action",
        "view_detail_action"
      ]
    },
    "toast": {
      "position": {
        "mobile": "top_center",
        "desktop": "top_right"
      },
      "types": [
        "success",
        "error",
        "warning",
        "info",
        "loading"
      ],
      "duration": {
        "success": "short",
        "info": "short",
        "warning": "medium",
        "error": "persistent_when_action_required",
        "loading": "until_operation_finishes"
      },
      "accessibility": [
        "screen_reader_announcement",
        "appropriate_live_region"
      ]
    }
  },
  "interaction_patterns": {
    "navigation": {
      "storefront_pages": [
        "HomePage",
        "ProductPage",
        "SearchPage",
        "WishlistPage",
        "OrdersPage",
        "ProfilePage"
      ],
      "standalone_pages_use_back_navigation": true,
      "preserve_scroll_position_when_appropriate": true
    },
    "add_to_cart": {
      "sequence": [
        "validate_product_availability",
        "validate_variant",
        "validate_quantity",
        "update_cart",
        "show_feedback"
      ],
      "feedback": "toast_and_cart_badge_update"
    },
    "checkout": {
      "sequence": [
        "validate_customer",
        "validate_address",
        "validate_cart",
        "validate_stock_server_side",
        "create_order",
        "create_payment_invoice"
      ],
      "guest_mode": true,
      "shipping_fee_source": "backend_defined_per_order",
      "payment_expiry_source": "verified_duitku_invoice_expiry"
    },
    "payment": {
      "provider": "Duitku POP",
      "redirect_result_is_authoritative": false,
      "source_of_truth": "verified_backend_payment_status",
      "final_status_sources": [
        "verified_duitku_callback",
        "server_side_status_verification"
      ],
      "show_payment_instructions_when_available": true
    },
    "order_tracking": {
      "mode": "guest",
      "lookup_key": "order_id",
      "data_exposure": "minimum_necessary_order_information",
      "never_trust_client_supplied_status": true
    },
    "inventory": {
      "validation": "server_side",
      "reservation_or_deduction": "atomic_backend_operation",
      "stock_and_availability_are_separate": true
    },
    "forms": {
      "validation": "client_and_server",
      "prevent_duplicate_submission": true,
      "preserve_user_input_on_recoverable_errors": true
    }
  },
